# ==========================================
# Finance One — Server Environment Template
# ==========================================

# Server Listening Port (Default: 3000)
PORT=3000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=production

# PostgreSQL Database Connection String
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_one?schema=public

# Cryptographic Secret for Signing Authentication JWTs (Minimum 32 characters recommended)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long

# Allowed Frontend Origins for CORS (Comma-separated for multiple origins)
# Example Production: https://financeone.app,https://www.financeone.app
# Example Development: http://localhost:5173
CLIENT_URL=http://localhost:5173
