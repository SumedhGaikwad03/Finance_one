// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// THESE ARE enums that our user could selste through with the options avaiable 

enum Category {
  FOOD
  FUEL
  SHOPPING
  BILLS
  ENTERTAINMENT
  HEALTH
  TRAVEL
  EDUCATION
  SUBSCRIPTION
  GIFT
  OTHER
}

enum Priority {
  ESSENTIAL
  GOOD_TO_HAVE
  LUXURY
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
}

//spacing makes it good 

model User {
  id           Int    @id @default(autoincrement())
  name         String
  email        String @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  budget       Budget[]
}

model Transaction {
  id              Int      @id @default(autoincrement())
  amount          Decimal
  category        Category
  priority        Priority
  title           String?
  notes           String?
  transactionDate DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
}

model Budget {
  id         Int          @id @default(autoincrement())
  amount     Decimal
  periodType BudgetPeriod
  startDate  DateTime     @default(now())
  endDate    DateTime
  isLocked   Boolean      @default(false)
  userId     Int
  user       User         @relation(fields: [userId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}
